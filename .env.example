# Copy to .env for local runs (node --env-file=.env src/server.ts).
# On Fly, set secrets with `fly secrets set` instead (see docs/deploy-fly.md).

# 32 random bytes, base64: openssl rand -base64 32. Losing it makes stored broker secrets unreadable.
ENCRYPTION_KEY=
# Invite code family members enter to create their login. Leave empty to close sign-up.
SIGNUP_CODE=
# Mobile + OTP sign-in through MSG91 (msg91.com). Leave empty to turn it off.
# The auth key is a secret. Whitelist the server's IP on it in the MSG91 panel if IP security is on.
MSG91_AUTH_KEY=
# OTP template id from MSG91 (DLT-approved, with the ##OTP## placeholder).
MSG91_TEMPLATE_ID=
OTP_EXPIRY_MINUTES=5
# Must be true for live (non-paper) accounts to send real orders.
LIVE_TRADING=false
DATABASE_PATH=./data/nexora.db
PORT=8080
# Web origins allowed to call the API (the Flutter web build), comma-separated.
CORS_ORIGINS=http://localhost:5000
