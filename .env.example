# Copy to .env for local runs (node --env-file=.env src/server.ts).
# On Fly, set secrets with `fly secrets set` instead (see docs/deploy-fly.md).

# Postgres. For local development without a server, Postgres runs in-process: pglite:./data/pg
DATABASE_URL=pglite:./data/pg
# The server's public URL: broker login redirects come back to <PUBLIC_URL>/broker-callback/<broker>.
PUBLIC_URL=http://localhost:8080

# Encryption keys for broker credentials, by version: 1:<base64>,2:<base64> (openssl rand -base64 32).
# Back them up: without them stored credentials can't be read. To rotate, add a version and run POST /admin/jobs/reencrypt/run.
ENCRYPTION_KEYS=
# Ed25519 key that signs access tokens: node src/cli.ts gen-jwt-key (paste the PEM, or base64 of it).
JWT_PRIVATE_KEY=
JWT_KEY_ID=k1
# Bearer token for /admin/* (creating users and clients, kill switch). Unset turns admin off.
ADMIN_TOKEN=

# console prints codes (development only); msg91 texts them.
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Must be true for live accounts to send real orders. Otherwise broker writes are logged, not sent.
LIVE_TRADING=false
# SEBI algo id from the exchange, once issued.
ALGO_ID=
RISK_ENFORCE_MARKET_HOURS=true
RISK_MAX_NOTIONAL_RUPEES=1000000
RISK_MAX_ORDERS_PER_DAY=500

# Off: every user may trade. On: needs a paid subscription and the Razorpay settings.
BILLING_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GRACE_DAYS=3

PORT=8080
# Web origins allowed to call the API (the Flutter web build), comma-separated.
CORS_ORIGINS=http://localhost:5000
LOG_LEVEL=info
