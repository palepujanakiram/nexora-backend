{
  "name": "nexora-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for NexoraApp: stores broker accounts and places signal orders from one static IP.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "user:create": "node dist/cli.js create-user"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
