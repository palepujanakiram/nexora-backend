{
  "name": "nexora-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Multi-broker order fan-out server for NexoraApp: one order to many broker accounts from one static IP.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "user:create": "node dist/cli.js create-user"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.16",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
